/* 线性 SVG 图标：inline data-URI，无需字体/图片文件
   用法：<view class="i i-bill"></view>
   尺寸可用 .i-sm / .i-lg 调整；颜色烘焙在主色 #0F3D34，换主色需重新生成本文件 */

.i {
  width: 44rpx;
  height: 44rpx;
  background-repeat: no-repeat;
  background-position: center;
  background-size: contain;
  flex-shrink: 0;
}
.i-sm { width: 32rpx; height: 32rpx; }
.i-lg { width: 56rpx; height: 56rpx; }


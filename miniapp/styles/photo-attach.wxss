/* 照片附件网格 —— 深绿轻奢，复用 app.wxss 设计 token */
.photo-block {
  margin-top: 8rpx;
}
.photo-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
  margin-top: 16rpx;
}
.photo-cell {
  position: relative;
  width: 200rpx;
  height: 200rpx;
  border-radius: 16rpx;
  overflow: hidden;
  background: #f7f6f3;
}
.photo-thumb {
  width: 100%;
  height: 100%;
  display: block;
}
.photo-del {
  position: absolute;
  top: 6rpx;
  right: 6rpx;
  width: 40rpx;
  height: 40rpx;
  line-height: 38rpx;
  text-align: center;
  border-radius: 50%;
  background: rgba(22, 33, 29, 0.6);
  color: #fff;
  font-size: 32rpx;
}
.photo-add {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
  border: 2rpx dashed #c9c3b8;
  background: #fcfbf9;
}
.photo-add-plus {
  font-size: 52rpx;
  line-height: 1;
  color: #0f3d34;
}
.photo-add-tip {
  margin-top: 8rpx;
  font-size: 22rpx;
  color: #6e7a74;
}

.mask {
  position: fixed;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  z-index: 1000;
  background: rgba(0, 0, 0, 0.4);
  display: flex;
  align-items: flex-end;
  justify-content: center;
}
.sheet {
  width: 100%;
  max-height: 78vh;
  background: #ffffff;
  border-radius: 24rpx 24rpx 0 0;
  padding: 16rpx 28rpx calc(24rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
}
.handle {
  width: 64rpx;
  height: 8rpx;
  border-radius: 8rpx;
  background: #e5e5e5;
  align-self: center;
  margin-bottom: 20rpx;
}
.title {
  font-size: 34rpx;
  font-weight: 650;
  color: #1a1a1a;
}
.sub {
  margin-top: 8rpx;
  margin-bottom: 20rpx;
  font-size: 24rpx;
  color: #999;
}
.list {
  max-height: 52vh;
}
.row {
  display: flex;
  align-items: center;
  padding: 28rpx 24rpx;
  margin-bottom: 12rpx;
  border-radius: 12rpx;
  background: var(--bg0);
  border: 1rpx solid transparent;
}
.row.on {
  background: rgba(15, 61, 52, 0.08);
  border-color: rgba(15, 61, 52, 0.25);
}
.row-hover {
  opacity: 0.88;
}
.row-body {
  flex: 1;
  min-width: 0;
}
.row-title {
  display: block;
  font-size: 30rpx;
  font-weight: 600;
  color: #1a1a1a;
}
.row-desc {
  display: block;
  margin-top: 6rpx;
  font-size: 22rpx;
  color: #999;
}
.check {
  font-size: 22rpx;
  color: var(--brand);
  font-weight: 600;
  flex-shrink: 0;
  margin-left: 12rpx;
}
.arrow {
  width: 14rpx;
  height: 14rpx;
  border-top: 3rpx solid #ccc;
  border-right: 3rpx solid #ccc;
  transform: rotate(45deg);
  flex-shrink: 0;
  margin-left: 12rpx;
}
.empty {
  padding: 48rpx 0;
  text-align: center;
  color: #999;
  font-size: 26rpx;
}
.cancel {
  margin-top: 12rpx !important;
  background: transparent !important;
  color: #999 !important;
  font-size: 28rpx !important;
  border: none !important;
}
.cancel::after {
  border: none;
}

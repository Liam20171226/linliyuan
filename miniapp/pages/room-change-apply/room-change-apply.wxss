.tip {
  background: rgba(15, 61, 52, 0.08);
  border: none;
  box-shadow: none;
}
.tip-text {
  font-size: 26rpx;
  color: var(--brand);
  line-height: 1.5;
}
.field {
  margin-bottom: 24rpx;
}
.field:last-child {
  margin-bottom: 0;
}
.label {
  display: block;
  font-size: 24rpx;
  color: #999999;
  margin-bottom: 10rpx;
}
.hint {
  display: block;
  margin-top: 10rpx;
  font-size: 22rpx;
  color: var(--brand);
  line-height: 1.4;
}
.input, .picker, .area {
  width: 100%;
  box-sizing: border-box;
  padding: 18rpx 20rpx;
  border-radius: 12rpx;
  background: var(--bg0);
  font-size: 28rpx;
  color: #1a1a1a;
}
.input.locked {
  color: #666;
  background: #eef1f0;
}
.area {
  min-height: 180rpx;
  line-height: 1.5;
}
.empty, .muted {
  font-size: 24rpx;
  color: #999999;
}

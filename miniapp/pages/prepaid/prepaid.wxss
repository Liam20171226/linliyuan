.summary { padding: 32rpx 28rpx; margin-bottom: 20rpx; }
.sum-lab { display: block; font-size: 24rpx; color: #999; }
.sum-val {
  display: block;
  margin-top: 12rpx;
  font-size: 48rpx;
  font-weight: 700;
  color: var(--brand);
}
.sum-hint {
  display: block;
  margin-top: 16rpx;
  font-size: 22rpx;
  color: #999;
  line-height: 1.5;
}
.sec { display: block; font-size: 26rpx; font-weight: 600; margin-bottom: 16rpx; }
.inp {
  border: 1rpx solid #dde5e1;
  border-radius: 12rpx;
  padding: 16rpx 20rpx;
  margin-bottom: 16rpx;
}
.op {
  margin: 0 !important;
  height: 72rpx !important;
  line-height: 72rpx !important;
  font-size: 28rpx !important;
  border-radius: 12rpx !important;
}
.op.primary { background: var(--brand) !important; color: #fff !important; }
.op::after { border: none !important; }
.card { background: #fff; border-radius: 16rpx; padding: 24rpx; margin-bottom: 20rpx; }

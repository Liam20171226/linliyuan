.seg {
  display: flex;
  gap: 8rpx;
  background: var(--bg0);
  border-radius: var(--radius-ctrl);
  padding: 6rpx;
  margin-bottom: 16rpx;
}
.seg-item {
  flex: 1;
  text-align: center;
  padding: 14rpx 0;
  font-size: 26rpx;
  color: var(--muted);
  border-radius: 12rpx;
}
.seg-item.on {
  background: var(--brand);
  color: #ffffff;
  font-weight: 600;
}

.search {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-bottom: 16rpx;
}
.search-input {
  flex: 1;
  height: 68rpx;
  padding: 0 20rpx;
  box-sizing: border-box;
  background: var(--surface);
  border-radius: var(--radius-ctrl);
  font-size: 26rpx;
  color: var(--ink);
}
.search-btn {
  flex-shrink: 0;
  height: 68rpx;
  line-height: 68rpx;
  padding: 0 28rpx;
  border-radius: var(--radius-ctrl);
  background: var(--brand);
  color: #ffffff;
  font-size: 26rpx;
}

.sec-title {
  margin: 24rpx 4rpx 12rpx;
  font-size: 26rpx;
  font-weight: 600;
  color: var(--ink);
}

.rec { margin-bottom: 16rpx; }
.rec-top {
  display: flex;
  align-items: center;
  gap: 12rpx;
}
.cat {
  flex-shrink: 0;
  padding: 4rpx 14rpx;
  border-radius: var(--radius-tag);
  font-size: 22rpx;
  line-height: 1.6;
  background: rgba(15, 61, 52, 0.10);
  color: var(--brand);
}
.rec-desc {
  display: block;
  margin-top: 12rpx;
  font-size: 26rpx;
  color: #3A4741;
  line-height: 1.55;
}
.rec-line {
  display: flex;
  align-items: baseline;
  gap: 16rpx;
  margin-top: 12rpx;
}
.rec-name {
  font-size: 30rpx;
  font-weight: 600;
  color: var(--ink);
}
.rec-mobile {
  font-size: 24rpx;
  color: var(--muted);
}
.rec-sub {
  display: block;
  margin-top: 8rpx;
  font-size: 24rpx;
  color: var(--muted);
}
.rec-reply {
  display: block;
  margin-top: 10rpx;
  padding: 16rpx 20rpx;
  background: var(--bg0);
  border-radius: var(--radius-ctrl);
  font-size: 24rpx;
  color: #3A4741;
  line-height: 1.55;
}
.rec-time {
  display: block;
  margin-top: 12rpx;
  font-size: 22rpx;
  color: var(--muted);
}
.acts {
  display: flex;
  gap: 16rpx;
  margin-top: 18rpx;
}
.act-btn {
  flex: 1;
  margin: 0 !important;
  padding: 0 !important;
  height: 68rpx !important;
  line-height: 68rpx !important;
  font-size: 26rpx !important;
  border-radius: var(--radius-ctrl) !important;
}
.act-btn::after { border: none !important; }
.act-ok {
  background: var(--brand) !important;
  color: #ffffff !important;
}
.act-no {
  background: var(--surface) !important;
  color: var(--danger) !important;
  border: 1rpx solid rgba(168, 68, 47, 0.4) !important;
}
.empty-box.soft {
  padding: 60rpx 20rpx;
  text-align: center;
}

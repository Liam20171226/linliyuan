.login {
  min-height: 100vh;
  padding: 0 0 64rpx;
  background: var(--bg0);
  box-sizing: border-box;
}

.hero-band {
  padding: 72rpx 48rpx 56rpx;
  background: #ffffff;
}
.brand {
  display: block;
  font-size: 52rpx;
  font-weight: 700;
  color: #1a1a1a;
  letter-spacing: 0.12em;
  font-family: "Songti SC", "STSong", "Noto Serif SC", serif;
}
.sub {
  display: block;
  margin-top: 12rpx;
  font-size: 24rpx;
  color: #999;
  line-height: 1.5;
}

.panel {
  margin: 20rpx 24rpx 0;
  padding: 36rpx 28rpx;
  background: #ffffff;
  border-radius: 16rpx;
}

.steps {
  display: flex;
  align-items: center;
  margin-bottom: 28rpx;
}
.step {
  display: flex;
  flex-direction: column;
  align-items: center;
  opacity: 0.4;
}
.step.on { opacity: 1; }
.step .n {
  width: 40rpx;
  height: 40rpx;
  border-radius: 50%;
  background: #eee;
  color: #999;
  font-size: 22rpx;
  font-weight: 700;
  display: flex;
  align-items: center;
  justify-content: center;
  line-height: 40rpx;
  text-align: center;
}
.step.on .n {
  background: var(--brand);
  color: #ffffff;
}
.step .t {
  margin-top: 8rpx;
  font-size: 20rpx;
  color: #999;
}
.bar {
  flex: 1;
  height: 2rpx;
  margin: 0 10rpx 28rpx;
  background: #eee;
}
.bar.on { background: var(--brand); }

.hint {
  margin-bottom: 24rpx;
  font-size: 24rpx;
  color: #999;
  line-height: 1.5;
}

.panel .btn-main { margin-bottom: 20rpx !important; }
.panel .phone { margin-bottom: 0 !important; }

.choose { margin: 28rpx 24rpx 0; }
.choose-title {
  display: block;
  font-size: 30rpx;
  font-weight: 650;
  color: #1a1a1a;
}
.choose-sub {
  display: block;
  margin: 8rpx 0 16rpx;
  font-size: 22rpx;
  color: #999;
}
.cell-hover { background: rgba(0, 0, 0, 0.03); }

.dev {
  margin: 40rpx 24rpx 0;
  padding: 24rpx 28rpx;
  border-radius: 16rpx;
  background: #ffffff;
  border: 1rpx dashed #ddd;
}
.dev-head {
  display: flex;
  justify-content: space-between;
  align-items: center;
}
.dev-title {
  font-size: 26rpx;
  font-weight: 600;
  color: #1a1a1a;
}
.dev-toggle {
  font-size: 22rpx;
  color: var(--brand);
}
.dev-hint {
  display: block;
  margin: 12rpx 0 20rpx;
  font-size: 22rpx;
  color: #999;
  line-height: 1.45;
}
.dev-row {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-bottom: 16rpx;
}
.btn-mini {
  margin: 0 !important;
  background: #f5f5f5 !important;
  color: #333 !important;
  font-size: 22rpx !important;
}
.ping-text {
  display: block;
  margin: 0 0 16rpx;
  padding: 12rpx 14rpx;
  font-size: 22rpx;
  color: #666;
  line-height: 1.4;
  background: #f7f7f7;
  border-radius: 8rpx;
  white-space: pre-wrap;
  word-break: break-all;
}

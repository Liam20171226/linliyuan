<view class="page login">
  <view class="hero-band">
    <text class="brand">邻里院</text>
    <text class="sub">微信授权登录，按手机号匹配小区身份；物业与业委会免密进入</text>
  </view>

  <view class="panel">
    <view class="steps">
      <view class="step {{step >= 1 ? 'on' : ''}}"><text class="n">1</text><text class="t">微信登录</text></view>
      <view class="bar {{step >= 2 ? 'on' : ''}}"></view>
      <view class="step {{step >= 2 ? 'on' : ''}}"><text class="n">2</text><text class="t">手机号</text></view>
      <view class="bar {{step >= 3 ? 'on' : ''}}"></view>
      <view class="step {{step >= 3 ? 'on' : ''}}"><text class="n">3</text><text class="t">选身份</text></view>
    </view>

    <view class="hint" wx:if="{{step === 1}}">第一步：用微信身份建立会话</view>
    <view class="hint" wx:elif="{{step === 2}}">第二步：授权手机号，系统自动匹配住户/物业/业委会</view>
    <view class="hint" wx:else>第三步：多个身份时弹窗选择其一进入</view>

    <button class="btn-main" bindtap="loginWx" loading="{{wxLoading}}" disabled="{{wxLoading}}">
      {{sessionToken ? '已登录微信，可重新登录' : '微信一键登录'}}
    </button>

    <button
      class="btn-ghost phone"
      open-type="getPhoneNumber"
      bindgetphonenumber="onGetPhoneNumber"
      disabled="{{!sessionToken || phoneLoading}}"
      loading="{{phoneLoading}}"
    >授权手机号并匹配身份</button>

    <button
      wx:if="{{step === 3 && identities.length}}"
      class="btn-ghost"
      style="margin-top:20rpx"
      bindtap="reopenPicker"
    >重新选择身份</button>
  </view>

  <view class="dev" wx:if="{{devEnabled}}">
    <view class="dev-head" bindtap="toggleDev">
      <text class="dev-title">开发调试</text>
      <text class="dev-toggle">{{showDev ? '收起' : '展开'}}</text>
    </view>
    <block wx:if="{{showDev}}">
      <text class="dev-hint">手机已连电脑热点：点「电脑热点」→「探测后端」→「开发登录」。仍不通再试「本机127.0.0.1」。</text>
      <view class="field-block">
        <text class="field-label">API 地址</text>
        <input class="field-input" value="{{apiBase}}" bindinput="onApiBaseInput" placeholder="http://127.0.0.1:8080/api/v1" />
      </view>
      <view class="dev-row">
        <button class="btn-mini" size="mini" bindtap="useLocalApi">本机127.0.0.1</button>
        <button class="btn-mini" size="mini" bindtap="useHotspotApi">电脑热点</button>
        <button class="btn-mini" size="mini" bindtap="useLanApi">局域网</button>
        <button class="btn-mini" size="mini" bindtap="pingBackend" loading="{{pinging}}">探测后端</button>
      </view>
      <text class="ping-text" wx:if="{{pingText}}">{{pingText}}</text>
      <view class="field-block">
        <text class="field-label">开发 code</text>
        <input class="field-input" value="{{code}}" bindinput="onCodeInput" placeholder="dev_r_13800138000" />
      </view>
      <view class="field-block">
        <text class="field-label">手机号</text>
        <input class="field-input" type="number" value="{{phone}}" bindinput="onPhoneInput" placeholder="13800138000" />
      </view>
      <button class="btn-ghost" bindtap="loginDev" loading="{{devLoading}}">开发登录</button>
    </block>
  </view>

  <identity-picker
    visible="{{pickerVisible}}"
    identities="{{pickerList}}"
    title="选择进入身份"
    subtitle="点选小区身份；住户多套房可分别进入。之后可在「我的」切换"
    bind:close="closePicker"
    bind:select="onPickIdentity"
  />
</view>

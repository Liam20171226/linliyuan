<view class="page">
  <view class="feed" wx:if="{{list.length}}">
    <view
      class="card"
      wx:for="{{list}}"
      wx:key="id"
      data-id="{{item.id}}"
      bindtap="open"
      hover-class="card-hover"
    >
      <view class="card-body">
        <view class="card-title-row">
          <text class="card-title">{{item.title}}</text>
          <text class="urgent" wx:if="{{item.urgent}}">紧急</text>
        </view>
        <text class="card-date">{{item.timeLabel}}</text>
      </view>
      <image
        wx:if="{{item.coverThumb}}"
        class="card-thumb"
        src="{{item.coverThumb}}"
        mode="aspectFill"
      />
    </view>
  </view>

  <view wx:if="{{!loading && !list.length}}" class="empty-box">
    <text class="empty-title">{{source === 'COMMITTEE' ? '暂无业委通知' : '暂无公告'}}</text>
    <text class="empty-desc">{{source === 'COMMITTEE' ? '业委会发布后会出现在这里' : '物业发布通知后会显示在这里'}}</text>
  </view>
</view>

.tip {
  background: rgba(15, 61, 52, 0.08);
  border: none;
  box-shadow: none;
}
.tip-text {
  font-size: 26rpx;
  color: var(--brand);
  line-height: 1.5;
}
.item {
  margin-bottom: 16rpx;
}
.row-top {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
  margin-bottom: 10rpx;
}
.title {
  font-size: 30rpx;
  font-weight: 700;
  color: #1a1a1a;
}
.status {
  font-size: 22rpx;
  padding: 4rpx 12rpx;
  border-radius: 8rpx;
  background: rgba(0, 0, 0, 0.04);
  color: var(--brand);
}
.status.PENDING {
  background: rgba(196, 92, 38, 0.12);
  color: #c45c26;
}
.status.APPROVED {
  background: rgba(31, 106, 90, 0.12);
  color: #1f6a5a;
}
.status.REJECTED {
  background: rgba(163, 75, 44, 0.12);
  color: #a34b2c;
}
.meta {
  display: block;
  font-size: 24rpx;
  color: #333333;
  line-height: 1.5;
  margin-top: 4rpx;
}
.meta.muted {
  color: #999999;
}

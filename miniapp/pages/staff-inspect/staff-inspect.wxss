.seg {
  display: flex;
  gap: 8rpx;
  background: var(--bg0);
  border-radius: var(--radius-ctrl);
  padding: 6rpx;
  margin-bottom: 16rpx;
}
.seg-item {
  flex: 1;
  text-align: center;
  padding: 14rpx 0;
  font-size: 26rpx;
  color: var(--muted);
  border-radius: 12rpx;
}
.seg-item.on {
  background: var(--brand);
  color: #ffffff;
  font-weight: 600;
}
.rec { margin-bottom: 16rpx; }
.rec-top {
  display: flex;
  align-items: center;
  gap: 12rpx;
}
.cat {
  flex-shrink: 0;
  padding: 4rpx 14rpx;
  border-radius: var(--radius-tag);
  font-size: 22rpx;
  line-height: 1.6;
  background: rgba(15, 61, 52, 0.10);
  color: var(--brand);
}
.rec-desc {
  display: block;
  margin-top: 12rpx;
  font-size: 28rpx;
  color: #16211D;
  font-weight: 600;
  line-height: 1.4;
}
.rec-sub {
  display: block;
  margin-top: 8rpx;
  font-size: 24rpx;
  color: var(--muted);
}
.rec-sub.claim { color: var(--accent); }
.rec-time {
  display: block;
  margin-top: 12rpx;
  font-size: 22rpx;
  color: var(--muted);
}
.empty-box.soft {
  padding: 60rpx 20rpx;
  text-align: center;
}

.page {
  min-height: 100vh;
  background: #fff;
  box-sizing: border-box;
}

.scroll { height: 100vh; }

.article {
  padding: 36rpx 32rpx calc(48rpx + env(safe-area-inset-bottom));
}

.title {
  display: block;
  font-size: 36rpx;
  font-weight: 650;
  color: #1a1a1a;
  line-height: 1.4;
}

.meta {
  display: flex;
  align-items: center;
  flex-wrap: wrap;
  gap: 8rpx;
  margin-top: 16rpx;
  font-size: 24rpx;
  color: #9aa49e;
}

.sep { color: #c5cec9; }

.urgent {
  margin-left: 8rpx;
  font-size: 20rpx;
  line-height: 1;
  padding: 6rpx 10rpx;
  border-radius: 6rpx;
  background: rgba(163, 75, 44, 0.12);
  color: #a34b2c;
}

.body { margin-top: 36rpx; }

.para { display: block; }

.body-img {
  display: block;
  width: 100%;
  margin: 8rpx 0 24rpx;
  border-radius: 12rpx;
  background: #f3f5f4;
}

.empty-body {
  font-size: 30rpx;
  color: #999;
  line-height: 1.8;
}

.att-box {
  margin-top: 16rpx;
  padding: 8rpx 24rpx;
  background: #f7f8f7;
  border-radius: 12rpx;
}
.att-title {
  display: block;
  padding-top: 20rpx;
  font-size: 24rpx;
  color: #888;
}
.att-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
  padding: 22rpx 0;
}
.att-name {
  flex: 1;
  min-width: 0;
  font-size: 28rpx;
  color: #1a1a1a;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.att-go {
  flex-shrink: 0;
  font-size: 24rpx;
  color: var(--brand);
}
.tap { opacity: 0.7; }

.state {
  padding: 160rpx 48rpx;
  text-align: center;
}
.state-title {
  display: block;
  font-size: 30rpx;
  font-weight: 600;
  color: #333;
}
.state-desc {
  display: block;
  margin-top: 12rpx;
  font-size: 24rpx;
  color: #999;
}

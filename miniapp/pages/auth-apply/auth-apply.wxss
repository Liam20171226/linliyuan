.tip {
  margin-bottom: 20rpx;
  background: rgba(15, 61, 52, 0.08);
  border: none;
  box-shadow: none;
}
.tip-text {
  font-size: 24rpx;
  color: var(--brand);
  line-height: 1.55;
}
.field-picker.static {
  color: #333333;
}
.field-picker.placeholder {
  color: #999999;
}
.field-picker.with-arrow {
  position: relative;
  padding-right: 56rpx;
}
.field-picker.with-arrow::after {
  content: "";
  position: absolute;
  right: 24rpx;
  top: 50%;
  width: 12rpx;
  height: 12rpx;
  margin-top: -8rpx;
  border-right: 3rpx solid #999999;
  border-bottom: 3rpx solid #999999;
  transform: rotate(45deg);
}
.field-hint {
  display: block;
  margin-top: 10rpx;
  font-size: 22rpx;
  color: #999999;
  line-height: 1.4;
}
.proof-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}
.proof-item {
  position: relative;
  width: 160rpx;
  height: 160rpx;
}
.proof-img {
  width: 160rpx;
  height: 160rpx;
  border-radius: 12rpx;
  background: #eef2ef;
}
.proof-del {
  position: absolute;
  top: -8rpx;
  right: -8rpx;
  width: 40rpx;
  height: 40rpx;
  border-radius: 50%;
  background: rgba(163, 75, 44, 0.95);
  color: #fff;
  font-size: 28rpx;
  line-height: 36rpx;
  text-align: center;
}
.proof-add {
  width: 160rpx;
  height: 160rpx;
  border-radius: 12rpx;
  border: 2rpx dashed rgba(31, 58, 50, 0.25);
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  background: rgba(231, 239, 233, 0.45);
}
.proof-add-plus {
  font-size: 48rpx;
  color: var(--brand);
  line-height: 1;
}
.proof-add-text {
  margin-top: 6rpx;
  font-size: 20rpx;
  color: #999999;
}

.mask {
  position: fixed;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  z-index: 1000;
  background: rgba(15, 61, 52, 0.45);
  display: flex;
  align-items: flex-end;
  justify-content: center;
}
.sheet {
  width: 100%;
  max-height: 82vh;
  background: #ffffff;
  border-radius: 28rpx 28rpx 0 0;
  padding: 16rpx 28rpx calc(24rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
}
.handle {
  width: 64rpx;
  height: 8rpx;
  border-radius: 8rpx;
  background: rgba(15, 61, 52, 0.18);
  align-self: center;
  margin-bottom: 16rpx;
}
.sheet-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 8rpx;
}
.sheet-title {
  font-size: 34rpx;
  font-weight: 700;
  color: #1a1a1a;
}
.sheet-close {
  font-size: 26rpx;
  color: var(--brand);
  padding: 8rpx 0 8rpx 24rpx;
}
.sheet-sub {
  font-size: 24rpx;
  color: #999999;
  margin-bottom: 16rpx;
}
.sheet-search {
  margin-bottom: 16rpx;
}
.sheet-search-input {
  width: 100%;
  box-sizing: border-box;
  height: 72rpx;
  padding: 0 24rpx;
  border-radius: 14rpx;
  background: rgba(231, 239, 233, 0.7);
  border: 1rpx solid rgba(31, 58, 50, 0.12);
  font-size: 28rpx;
  color: #1a1a1a;
}
.sheet-list {
  max-height: 48vh;
  min-height: 200rpx;
}
.sheet-row {
  padding: 24rpx 20rpx;
  margin-bottom: 12rpx;
  border-radius: 16rpx;
  background: rgba(231, 239, 233, 0.55);
  border: 1rpx solid rgba(31, 58, 50, 0.1);
}
.sheet-row.on {
  background: rgba(26, 107, 92, 0.12);
  border-color: rgba(26, 107, 92, 0.35);
}
.sheet-row-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #1a1a1a;
}
.sheet-empty {
  padding: 48rpx 24rpx;
  text-align: center;
  font-size: 26rpx;
  color: #999999;
  line-height: 1.5;
}
.cascade-wrap {
  display: flex;
  flex-direction: column;
}
.cascade-labels {
  display: flex;
  justify-content: space-around;
  padding: 0 8rpx 8rpx;
  font-size: 22rpx;
  color: #999999;
}
.cascade-view {
  width: 100%;
  height: 360rpx;
}
.cascade-item {
  line-height: 68rpx;
  text-align: center;
  font-size: 28rpx;
  color: #1a1a1a;
}
.sheet-confirm {
  margin-top: 16rpx;
  background: var(--brand);
  color: #fff;
  border-radius: 14rpx;
  font-size: 30rpx;
}

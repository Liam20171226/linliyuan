.page {
  min-height: 100vh;
  background: #fff;
  box-sizing: border-box;
}
.scroll { height: 100vh; }
.state {
  padding: 120rpx 48rpx;
  text-align: center;
}
.state-title {
  display: block;
  font-size: 32rpx;
  font-weight: 600;
  color: var(--brand);
  margin-bottom: 12rpx;
}
.state-desc {
  font-size: 26rpx;
  color: var(--muted);
  line-height: 1.5;
}
.article {
  padding: 36rpx 32rpx calc(48rpx + env(safe-area-inset-bottom));
}
.title {
  display: block;
  font-size: 36rpx;
  font-weight: 650;
  color: #1a1a1a;
  line-height: 1.4;
}
.meta {
  display: flex;
  align-items: center;
  flex-wrap: wrap;
  gap: 8rpx;
  margin-top: 16rpx;
  font-size: 24rpx;
  color: #9aa49e;
}
.sep { color: #c5cec9; }
.range {
  display: block;
  margin-top: 8rpx;
  font-size: 24rpx;
  color: #9aa49e;
}
.bg {
  display: block;
  margin-top: 28rpx;
  font-size: 28rpx;
  color: #3A4741;
  line-height: 1.6;
}
.room-card {
  margin-top: 28rpx;
  margin-bottom: 8rpx;
}
.room-hint {
  display: block;
  margin-top: 12rpx;
  font-size: 22rpx;
  color: var(--muted);
  line-height: 1.4;
}
.hint {
  display: block;
  font-size: 26rpx;
  color: var(--muted);
  padding: 12rpx 0;
}
.sec-lab {
  display: block;
  margin: 28rpx 0 16rpx;
  font-size: 26rpx;
  font-weight: 600;
  color: var(--brand);
}
.opt {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin: 0 0 16rpx;
  padding: 0 28rpx;
  min-height: 88rpx;
  box-sizing: border-box;
  background: #fff;
  color: var(--brand);
  border: 2rpx solid rgba(15, 61, 52, 0.3);
  border-radius: 16rpx;
  font-size: 28rpx;
}
.opt.on {
  background: rgba(15, 61, 52, 0.08);
  border-color: var(--brand);
  font-weight: 600;
}
.opt.is-locked {
  opacity: 0.92;
}
.opt-text { flex: 1; padding: 20rpx 0; line-height: 1.4; }
.opt-tag {
  flex-shrink: 0;
  margin-left: 16rpx;
  font-size: 22rpx;
  color: var(--brand);
}
.empty-opts {
  padding: 24rpx 0;
  text-align: center;
  font-size: 26rpx;
  color: var(--muted);
}
.foot-hint {
  display: block;
  margin-top: 12rpx;
  font-size: 22rpx;
  color: var(--muted);
  line-height: 1.4;
}
